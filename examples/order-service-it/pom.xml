<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dominys</groupId>
        <artifactId>examples</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-service-it</artifactId>

    <name>order-service-it</name>
    <description>
        Cucumber + JEXL service-level (e2e) tests. Depends ONLY on order-service-api-client,
        so it can never reach into the service implementation - it talks to a running
        service over REST. The service is started in a Docker container by
        Testcontainers (or overridden with -Dservice.baseUrl).
    </description>

    <dependencies>
        <!-- Cujex: the reusable Cucumber + JEXL framework under test here as the
             example consumer. Brings its own transitive Cucumber/Spring/Jackson/JEXL
             API, but the explicit deps below are kept so the example compiles against
             them directly and documents exactly what a suite uses. -->
        <dependency>
            <groupId>io.github.dominys</groupId>
            <artifactId>cujex-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- cujex-kafka: the optional Kafka extension exercised by the Kafka
             scenarios. Opt-in; brings the Kafka client, Awaitility and the
             suite-lifetime consumer/producer infrastructure. -->
        <dependency>
            <groupId>io.github.dominys</groupId>
            <artifactId>cujex-kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- The one and only production dependency: the shared contract (the Spring
             client, which transitively brings the API model). Depending on
             order-service here would defeat the whole point, so we do not. -->
        <dependency>
            <groupId>io.github.dominys</groupId>
            <artifactId>order-service-api-client</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JEXL: preprocessing engine for ${...} expressions in feature files -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-jexl3</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Jackson: maps data-table rows into typed records -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Required at runtime by Cucumber 8's NDJSON/HTML report writer
             (its Jackson 2 JsonProvider needs the jdk8 datatype module) -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Cucumber + Spring glue (lightweight Spring context, no Boot) -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Platform suite that discovers and runs the .feature files -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: builds and runs the service image for the suite -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers Kafka: runs a throwaway broker for the Kafka scenarios -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JaCoCo agent only. prepare-agent sets the argLine that failsafe's
                 forked JVM uses, so the e2e feature runs record which cujex-core/kafka
                 lines they hit (into target/jacoco.exec). This module has no main code
                 of its own, so the inherited per-module report is switched off; the
                 exec data is consumed by cujex-coverage's aggregate report instead. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- The Cucumber suite is an integration test: it needs the service jar
                 and a Docker image, so it runs in the verify phase via failsafe,
                 not in unit-test (surefire) territory. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/RunCucumberIT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
