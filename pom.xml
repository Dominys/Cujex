<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <!-- Published as io.github.dominys per the Maven Central convention for
         projects hosted at github.com/Dominys (no custom domain required). -->
    <groupId>io.github.dominys</groupId>
    <artifactId>cujex-parent</artifactId>
    <version>1.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Cujex (parent)</name>
    <description>
        Example of service-level / e2e testing with Cucumber + JEXL, split into a
        deployable Spring Boot service and a test module that talks to it over REST.
    </description>
    <url>https://github.com/Dominys/Cujex</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://github.com/Dominys/Cujex/blob/main/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Dominys</id>
            <name>Roman Bezpalko</name>
            <url>https://github.com/Dominys</url>
        </developer>
    </developers>

    <!-- Children inherit this SCM verbatim; don't append each module path,
         which would yield non-cloneable URLs like .../Cujex.git/cujex-core. -->
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/Dominys/Cujex.git</connection>
        <developerConnection>scm:git:git@github.com:Dominys/Cujex.git</developerConnection>
        <url>https://github.com/Dominys/Cujex</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <!-- The reusable Cucumber + JEXL framework (Cujex). Published library,
             independent of the order-service example below. -->
        <module>cujex-core</module>

        <!-- Optional Cujex extension: Kafka testing support (one consumer per
             topic, consumer-group readiness waits, per-scenario message filtering).
             Depends on cujex-core; a suite only pulls it in if it tests messaging. -->
        <module>cujex-kafka</module>

        <!-- Runnable examples that consume cujex-core: a deployable order-service
             plus the e2e tests that exercise it. Grouped under their own aggregator. -->
        <module>examples</module>

        <!-- Reporting-only: rolls cujex-core/kafka unit coverage together with the
             coverage their classes get from the example e2e runs, into one Sonar
             report. Last so all measured modules are built first. -->
        <module>cujex-coverage</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions -->
        <cucumber.version>8.0.4</cucumber.version>
        <spring.version>7.0.10</spring.version>
        <spring-boot.version>4.1.2</spring-boot.version>
        <jexl.version>3.7.1</jexl.version>
        <jackson.version>2.22.4</jackson.version>
        <assertj.version>3.27.7</assertj.version>
        <lombok.version>1.18.48</lombok.version>
        <junit.version>6.1.3</junit.version>
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Plugin versions -->
        <surefire.version>3.6.1</surefire.version>
        <failsafe.version>3.6.1</failsafe.version>
        <compiler.plugin.version>3.16.0</compiler.plugin.version>
        <jacoco.version>0.8.13</jacoco.version>

        <!-- Maven Central (Central Portal) publishing. Only cujex-core and
             cujex-kafka (plus this parent POM) are published; the examples and the
             coverage module flip cujex.publish.skip to true so the central plugin
             skips them. -->
        <central-publishing.plugin.version>0.9.0</central-publishing.plugin.version>
        <maven-source.plugin.version>3.3.1</maven-source.plugin.version>
        <maven-javadoc.plugin.version>3.11.2</maven-javadoc.plugin.version>
        <maven-gpg.plugin.version>3.2.8</maven-gpg.plugin.version>
        <cujex.publish.skip>false</cujex.publish.skip>

        <!-- Sonar: the example modules are sample consumers, not part of the
             published product, so they are kept out of both analysis and coverage.
             Coverage is read from the cross-module aggregate (see cujex-coverage),
             which combines unit tests and the e2e feature runs for core + kafka. -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${maven.multiModuleProjectDirectory}/cujex-coverage/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/examples/**</sonar.exclusions>
        <sonar.coverage.exclusions>**/examples/**</sonar.coverage.exclusions>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Our own modules -->
            <dependency>
                <groupId>io.github.dominys</groupId>
                <artifactId>cujex-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dominys</groupId>
                <artifactId>cujex-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dominys</groupId>
                <artifactId>order-service-api-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.dominys</groupId>
                <artifactId>order-service-api-client</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- BOMs are declared most-specific first: the first import to manage a
                 given artifact wins, so these pin Cucumber/Spring/Jackson/JUnit ahead
                 of the broad spring-boot-dependencies and testcontainers BOMs below. -->
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Not managed by any imported BOM -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-jexl3</artifactId>
                <version>${jexl.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- Line/branch coverage. Applied only to the published library
                     modules (cujex-core, cujex-kafka); the examples app is a
                     demo and is intentionally left out of the coverage metric. -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Active for the whole reactor (extensions=true replaces the default
                 deploy): routes `mvn deploy` to the Central Portal. Releases are
                 auto-published after validation; -SNAPSHOT versions go to the Central
                 snapshot repository. Modules that must not be published set
                 cujex.publish.skip=true. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>${central-publishing.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>central</publishingServerId>
                    <autoPublish>true</autoPublish>
                    <skipPublishing>${cujex.publish.skip}</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Enabled only when cutting a release (the release workflow runs
             `mvn -Prelease deploy`). Central requires every released artifact to
             ship signed -sources and -javadoc jars; these are kept out of normal
             CI/snapshot builds so they stay fast. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc.plugin.version}</version>
                        <configuration>
                            <!-- Relaxed so missing/strict Javadoc never fails a
                                 release; the jar is a Central requirement, not a
                                 documentation gate. -->
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Non-interactive signing in CI (passphrase comes from
                                 the MAVEN_GPG_PASSPHRASE env var). -->
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
